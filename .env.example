# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ceebuild-items"

# App port (used in dev; Docker overrides this)
PORT=6011

# --- Authentication (required) ---------------------------------------------
# Secret used by NextAuth to sign the login session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out. If it is missing nobody can sign in (viewing still works).
AUTH_SECRET=""

# Public address of the dashboard, used by NextAuth. Use https:// here once it is served over
# HTTPS (that also marks the session cookie Secure).
NEXTAUTH_URL="http://192.168.1.190:6011"

# Login users are stored in the "users" table. Manage them with:
#   npm run users -- add <username> --name "Full Name" --role Admin|User|Viewer
#   npm run users -- sync config/users.json      (list format: config/users.example.json)
#   npm run users -- list | set-password | set-role | disable | enable
# Roles: Admin = everything incl. deletes & master dropdowns; User = view/create/edit;
#        Viewer = read-only.

# --- AI (Groq) --------------------------------------------------------------
# Read only from here; it is never stored in the database or accepted from the browser.
GROQ_API_KEY=""

# --- PO reading: OCR + extraction (Google Gemini) - M15 "Add order = attach PO copy" ----------
# Normal set-up: Gemini runs in n8n (workflow "Ceebuild – Gemini proxy", PAID API credential), so
# leave GEMINI_API_KEY empty and set the N8N_* values below. GEMINI_API_KEY, when set, is used
# directly instead (paid-tier key only: Google does not use paid API data for training).
GEMINI_API_KEY=""
# Optional. Default gemini-2.5-flash. Also sent to n8n.
GEMINI_MODEL=""

# --- n8n link (PO mails read by n8n; Gemini through n8n) - see docs/PO_INTAKE.md -------------
# Dashboard -> n8n: webhooks ceebuild-gemini and ceebuild-read-po-mail, header x-ceebuild-key.
N8N_WEBHOOK_URL="https://pujagrwal1506.app.n8n.cloud/webhook"
N8N_WEBHOOK_KEY=""
# n8n -> dashboard: /api/n8n/* with header x-api-key (>= 16 characters).
N8N_API_KEY=""

# --- Mail archive (read through the email portal API, no database login here) ---------------
# Match Emails Portal backend route /api/db-emails/ceebuild-po (Ceebuild PO mails; attachments on Drive).
MAIL_API_URL="http://192.168.1.190:6002"

# --- Orders mailbox via Gmail API (older alternative to the mail archive) - optional ----------
# Google OAuth "Desktop app" client; then `npm run gmail-auth` signed in as the mailbox prints the
# refresh token. Read-only scope (gmail.readonly). Without these, only upload works.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_MAILBOX="info@ceebuildcompany.com"

# --- Attachment storage (S3-compatible) -------------------------------------
# Required for uploads/previews. There are NO defaults for the access key/secret.
S3_ENDPOINT_URL="http://192.168.1.190:8500"
S3_BUCKET="ceebuild-docket"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- Daily red-flag alerts ----------------------------------------------------
# Secret for GET /api/alerts (header x-api-key). n8n polls it daily and sends the
# ?format=text digest by WhatsApp / email. At least 16 characters; leave empty to disable (503).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ALERTS_API_KEY=""
