generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ItemTable {
  id               Int      @id @default(autoincrement())
  uniqueNo         String?  @map("unique_no")
  docketNoQtnNo    String?  @map("docket_no_qtn_no")
  itemNameParty    String?  @map("item_name_party")
  uom              String?
  qty              String?
  ourItemNot       String?  @map("our_item_not")
  typeOfItem       String?  @map("type_of_item")
  ourItemName      String?  @map("our_item_name")
  size             String?
  sectionMm        String?  @map("section_mm")
  sectionalWtKgMtr String?  @map("sectional_wt_kg_mtr")
  lengthInMtr      String?  @map("length_in_mtr")
  unitWtOfMemberKg String?  @map("unit_wt_of_member_kg")
  weightPerPiece   String?  @map("weight_per_piece")
  price            String?
  uomOfQtn         String?  @map("uom_of_qtn")
  a                String?
  freightPerKg     String?  @map("freight_per_kg")
  status           String?
  // HSN on the offer; blank = default from the item name (7308 structures, 8310 danger plates).
  hsn              String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("iteam-table")
}

model DockerPartyName {
  id               Int      @id @default(autoincrement())
  // Stored trimmed + upper-case (normalizeDocketNo); unique so two saves can't get the same number.
  docketNoQtnNo    String?  @unique @map("docket_no_qtn_no")
  partyName        String?  @map("party_name")
  address          String?
  state            String?
  utility          String?
  deliveryLocation String?  @map("delivery_location")
  // Site state for freight (state = billing state for GST). Blank = same as state.
  deliveryState    String?  @map("delivery_state")
  type             String?
  price            String?
  payment          String?
  delivery         String?
  warranty         String?
  approval         String?
  inspection       String?
  attachments      String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Orders raised when this offer became a PO (A15). Linked by id; ON DELETE RESTRICT.
  orders Order[]

  @@map("docket-party-name")
}

model TreamAndConditions {
  id         Int      @id @default(autoincrement())
  price      String?
  payment    String?
  delivery   String?
  warranty   String?
  approval   String?
  inspection String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("tream-and-conditions")
}

model EditLog {
  id        Int      @id @default(autoincrement())
  tableName String   @map("table_name")
  recordId  Int      @map("record_id")
  fieldName String   @map("field_name")
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  // Server-verified identity of the user who made the change (null for legacy rows)
  userId    Int?     @map("user_id")
  userName  String?  @map("user_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tableName, recordId])
  @@map("edit-logs")
}

model MasterValue {
  id        Int      @id @default(autoincrement())
  type      String // e.g. 'PARTY_NAME', 'STATE', 'UTILITY', 'ADDRESS', 'STATUS'
  value     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("master-values")
}

// Dashboard login accounts. Manage with `npm run users -- <command>` (see scripts/users.ts).
model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  // Sign-in email. Self sign-ups always have one; older accounts get it via `npm run users -- set-email`.
  email          String?   @unique
  name           String
  // 'Admin' | 'User' | 'Viewer'
  role           String    @default("User")
  passwordHash   String    @map("password_hash")
  isActive       Boolean   @default(true) @map("is_active")
  // Bumped on password/role change or disable to invalidate existing sessions
  sessionVersion Int       @default(1) @map("session_version")
  // M14: named technical user who may add drawings to the Approved Drawing Library (Admin approves).
  drawingEditor  Boolean   @default(false) @map("drawing_editor")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------------------
// A15: order-to-execution module. An order starts when an offer (docket) becomes a PO.
// New tables use real types and foreign keys among themselves.
// ---------------------------------------------------------------------------

model Order {
  id            Int             @id @default(autoincrement())
  docketId      Int             @map("docket_id")
  docket        DockerPartyName @relation(fields: [docketId], references: [id], onDelete: Restrict)
  // Docket number when the order was created (the docket can be renumbered later).
  docketNo      String?         @map("docket_no")
  poNumber      String          @unique @map("po_number")
  poDate        DateTime        @map("po_date") @db.Date
  client        String?
  remarks       String?
  // M14: contract value (Rs, incl. tax) and contractual delivery date, for billing and delay flags.
  contractValue Decimal?        @map("contract_value") @db.Decimal(16, 2)
  deliveryDue   DateTime?       @map("delivery_due") @db.Date
  createdById   Int?            @map("created_by_id")
  createdByName String?         @map("created_by_name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // ---- M15: read from the PO copy (Add Order = attach PO copy). All optional; see docs/PO_INTAKE.md.
  // PO_COPY (read from the attached PO) | MANUAL (typed, older orders)
  poSource         String?   @map("po_source")
  customerGstin    String?   @map("customer_gstin")
  billingAddress   String?   @map("billing_address")
  deliveryAddress  String?   @map("delivery_address")
  amendmentNo      String?   @map("amendment_no")
  amendmentDate    DateTime? @map("amendment_date") @db.Date
  endClient        String?   @map("end_client")
  state            String?
  project          String?
  scheme           String?
  contactPerson    String?   @map("contact_person")
  contactEmail     String?   @map("contact_email")
  contactPhone     String?   @map("contact_phone")
  basicValue       Decimal?  @map("basic_value") @db.Decimal(16, 2)
  gstPct           Decimal?  @map("gst_pct") @db.Decimal(6, 2)
  gstAmount        Decimal?  @map("gst_amount") @db.Decimal(16, 2)
  // Total value incl. GST as printed on the PO (contractValue is set from it on Confirm).
  totalValue       Decimal?  @map("total_value") @db.Decimal(16, 2)
  priceBasis       String?   @map("price_basis")
  freight          String?
  paymentTerms     String?   @map("payment_terms")
  advancePct       Decimal?  @map("advance_pct") @db.Decimal(6, 2)
  creditDays       Int?      @map("credit_days")
  // Delivery schedule / phasing as written; the completion date goes to deliveryDue.
  deliverySchedule String?   @map("delivery_schedule")
  ldPenalty        String?   @map("ld_penalty")
  pbgPct           Decimal?  @map("pbg_pct") @db.Decimal(6, 2)
  sdPct            Decimal?  @map("sd_pct") @db.Decimal(6, 2)
  warranty         String?
  inspection       String?
  testCertificates String?   @map("test_certificates")
  galvSpec         String?   @map("galv_spec")
  bomRef           String?   @map("bom_ref")
  drawingRef       String?   @map("drawing_ref")
  approvalLetterNo String?   @map("approval_letter_no")
  // What the PO says about the drawing: APPROVED | TO_BE_APPROVED | NOT_STATED
  drawingStatus    String?   @map("drawing_status")
  // AI reading kept as read: {model, at, fields: {key: {value, confidence, note}}, lines: [...]}.
  poExtract        Json?     @map("po_extract")
  // Hold: BOM/drawing waits for client confirmation. The indent job stops while it is set.
  onHold           Boolean   @default(false) @map("on_hold")
  holdReason       String?   @map("hold_reason")
  holdSince        DateTime? @map("hold_since")
  holdByName       String?   @map("hold_by_name")
  // Indent job (BOM -> drawing -> indent) started on Confirm: last result.
  // ON_HOLD | BOM_NEEDED | BOM_FLAGS | DRAWING_PENDING | INDENT_DRAFTED | FAILED
  jobStatus        String?   @map("job_status")
  jobNote          String?   @map("job_note")
  jobAt            DateTime? @map("job_at")

  poLines              OrderPoLine[]
  documents            OrderDocument[]
  lines                OrderLine[]
  rmIndents            RmIndent[]
  rmReceipts           RmReceipt[]
  cuttingPlans         CuttingPlan[]
  pieceRoutings        PieceRouting[]
  productionEntries    ProductionEntry[]
  stageInspections     StageInspection[]
  invoices             Invoice[]
  collections          Collection[]
  securities           OrderSecurity[]
  bomUploads           BomUpload[]
  bomPieces            BomPiece[]
  galvChallans         GalvChallan[]
  inspections          Inspection[]
  dispatchInstructions DispatchInstruction[]
  dispatches           Dispatch[]

  @@index([docketId])
  @@map("orders")
}

// Snapshot of the quotation lines at PO time, so later quotation edits do not change the order.
// Text fields copy iteam-table as-is.
model OrderLine {
  id             Int     @id @default(autoincrement())
  orderId        Int     @map("order_id")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceItemId   Int?    @map("source_item_id")
  itemName       String? @map("item_name")
  ourItemName    String? @map("our_item_name")
  uom            String?
  qty            String?
  price          String?
  weightPerPiece String? @map("weight_per_piece")

  @@index([orderId])
  @@map("order_lines")
}

// M15: one line of the PO as printed (kept apart from order_lines, the quotation snapshot).
model OrderPoLine {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo       Int      @map("line_no")
  description  String
  hsn          String?
  // MT | KG | NOS | SETS | KM | MTR | ... (normalised)
  unit         String?
  qty          Decimal? @db.Decimal(16, 3)
  unitRate     Decimal? @map("unit_rate") @db.Decimal(16, 2)
  lineValue    Decimal? @map("line_value") @db.Decimal(16, 2)
  // Allowed quantity variation, e.g. 25 for +/-25 %.
  qtyVarPct    Decimal? @map("qty_var_pct") @db.Decimal(6, 2)
  // Our quoted rate for the matching docket item (quotation module), when one matched.
  quotedRate   Decimal? @map("quoted_rate") @db.Decimal(16, 2)
  quotedItemId Int?     @map("quoted_item_id")

  @@index([orderId])
  @@map("order_po_lines")
}

// M15: a file kept against an order (PO copy, BOM, drawing). intakeId is set while it is
// still being reviewed; orderId once the order is confirmed.
model OrderDocument {
  id             Int       @id @default(autoincrement())
  orderId        Int?      @map("order_id")
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  intakeId       Int?      @map("intake_id")
  intake         PoIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  // PO | BOM | DRAWING | OTHER
  kind           String
  fileName       String    @map("file_name")
  s3Key          String?   @map("s3_key")
  mimeType       String?   @map("mime_type")
  sizeBytes      Int?      @map("size_bytes")
  // UPLOAD | MAILBOX
  source         String    @default("UPLOAD")
  gmailMessageId String?   @map("gmail_message_id")
  uploadedByName String?   @map("uploaded_by_name")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@index([intakeId])
  @@map("order_documents")
}

// M15: one "Add Order" attempt: the attached PO copy, what the AI read, and its outcome.
model PoIntake {
  id             Int       @id @default(autoincrement())
  // EXTRACTED | CONFIRMED | DISCARDED | FAILED
  status         String    @default("EXTRACTED")
  // UPLOAD | MAILBOX
  source         String    @default("UPLOAD")
  gmailMessageId String?   @map("gmail_message_id")
  mailSubject    String?   @map("mail_subject")
  model          String?
  extracted      Json?
  error          String?
  orderId        Int?      @map("order_id")
  createdById    Int?      @map("created_by_id")
  createdByName  String?   @map("created_by_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  confirmedAt    DateTime? @map("confirmed_at")

  documents OrderDocument[]

  @@map("po_intakes")
}

// One uploaded client BOM file. The order's current BOM is its latest upload.
model BomUpload {
  id              Int       @id @default(autoincrement())
  orderId         Int       @map("order_id")
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName        String    @map("file_name")
  s3Key           String?   @map("s3_key")
  sheetName       String?   @map("sheet_name")
  // Which spreadsheet column fed each piece field, e.g. {"markNo":"MARK NO","lengthMm":"LENGTH"}.
  columnMap       Json      @map("column_map")
  rowCount        Int       @default(0) @map("row_count")
  // DRAFT or CORRECT
  status          String    @default("DRAFT")
  uploadedById    Int?      @map("uploaded_by_id")
  uploadedByName  String?   @map("uploaded_by_name")
  confirmedById   Int?      @map("confirmed_by_id")
  confirmedByName String?   @map("confirmed_by_name")
  confirmedAt     DateTime? @map("confirmed_at")
  // Set when an Admin confirms a BOM that still has flags.
  overrideNote    String?   @map("override_note")
  // M14: null = client BOM file; QUOTATION = copied from the docket's costed item BOMs.
  source          String?
  createdAt       DateTime  @default(now()) @map("created_at")

  pieces BomPiece[]

  @@index([orderId])
  @@map("bom_uploads")
}

// One BOM row: a mark (piece) with section, length and quantity, plus check flags.
model BomPiece {
  id                 Int       @id @default(autoincrement())
  uploadId           Int       @map("upload_id")
  upload             BomUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  orderId            Int       @map("order_id")
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rowNo              Int       @map("row_no")
  markNo             String?   @map("mark_no")
  description        String?
  section            String?
  // Normalised section used to look up section_master, e.g. "ISMC100X50".
  sectionKey         String?   @map("section_key")
  lengthMm           Int?      @map("length_mm")
  qtyPerSet          Decimal?  @map("qty_per_set") @db.Decimal(14, 3)
  sets               Decimal?  @db.Decimal(14, 3)
  totalQty           Decimal?  @map("total_qty") @db.Decimal(14, 3)
  kgPerM             Decimal?  @map("kg_per_m") @db.Decimal(10, 3)
  unitWtKg           Decimal?  @map("unit_wt_kg") @db.Decimal(14, 3)
  totalWtKg          Decimal?  @map("total_wt_kg") @db.Decimal(16, 3)
  // The spreadsheet row as read, for columns not mapped to a field.
  raw                Json?
  flagMarkLength     Boolean   @default(false) @map("flag_mark_length")
  flagBlankQty       Boolean   @default(false) @map("flag_blank_qty")
  flagKgm            Boolean   @default(false) @map("flag_kgm")
  flagFractionalSets Boolean   @default(false) @map("flag_fractional_sets")
  flagSection        Boolean   @default(false) @map("flag_section")
  issues             String?

  @@index([uploadId])
  @@index([orderId, markNo])
  @@map("bom_pieces")
}

// Approved sections from the GTP (e.g. SBPDCL letter 2333 dt 28-07-2025), with standard kg/m.
model SectionMaster {
  id         Int      @id @default(autoincrement())
  sectionKey String   @unique @map("section_key")
  label      String
  kgPerM     Decimal  @map("kg_per_m") @db.Decimal(10, 3)
  grade      String?
  approved   Boolean  @default(true)
  // Longest bar the mill supplies for this section (null = plan_settings.max_custom_mm),
  // e.g. ISMC 100x50 up to 6600 mm (3 x 2200).
  maxBarMm   Int?     @map("max_bar_mm")
  source     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("section_master")
}

// Galvanising job-work challan, out to the galvaniser or back in.
model GalvChallan {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  challanNo     String   @map("challan_no")
  // OUT or IN
  direction     String
  challanDate   DateTime @map("challan_date") @db.Date
  jobWorker     String?  @map("job_worker")
  blackWtKg     Decimal? @map("black_wt_kg") @db.Decimal(14, 3)
  galvWtKg      Decimal? @map("galv_wt_kg") @db.Decimal(14, 3)
  remarks       String?
  createdById   Int?     @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lines GalvChallanLine[]

  @@unique([orderId, challanNo, direction])
  @@map("galv_challans")
}

model GalvChallanLine {
  id        Int         @id @default(autoincrement())
  challanId Int         @map("challan_id")
  challan   GalvChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  markNo    String      @map("mark_no")
  pieces    Int

  @@index([challanId])
  @@map("galv_challan_lines")
}

// Inspection call / material clearance (MC).
model Inspection {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspectionNo   String   @map("inspection_no")
  mcNo           String?  @map("mc_no")
  inspectionDate DateTime @map("inspection_date") @db.Date
  piecesCleared  Int?     @map("pieces_cleared")
  wtClearedKg    Decimal? @map("wt_cleared_kg") @db.Decimal(14, 3)
  remarks        String?
  createdById    Int?     @map("created_by_id")
  createdByName  String?  @map("created_by_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("inspections")
}

// Dispatch instruction (DI) from the client.
model DispatchInstruction {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  diNo          String   @map("di_no")
  diDate        DateTime @map("di_date") @db.Date
  pieces        Int?
  wtKg          Decimal? @map("wt_kg") @db.Decimal(14, 3)
  remarks       String?
  createdById   Int?     @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dispatches Dispatch[]

  @@unique([orderId, diNo])
  @@map("dispatch_instructions")
}

model Dispatch {
  id            Int                  @id @default(autoincrement())
  orderId       Int                  @map("order_id")
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  diId          Int?                 @map("di_id")
  di            DispatchInstruction? @relation(fields: [diId], references: [id], onDelete: SetNull)
  invoiceNo     String?              @map("invoice_no")
  ewayBillNo    String?              @map("eway_bill_no")
  lrNo          String?              @map("lr_no")
  vehicleNo     String?              @map("vehicle_no")
  dispatchDate  DateTime             @map("dispatch_date") @db.Date
  pieces        Int?
  wtKg          Decimal?             @map("wt_kg") @db.Decimal(14, 3)
  remarks       String?
  createdById   Int?                 @map("created_by_id")
  createdByName String?              @map("created_by_name")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([orderId])
  @@index([diId])
  @@map("dispatches")
}

// ---------------------------------------------------------------------------
// A15 steps 2-4 + M14: RM indent / receipt / cutting plan, machine plan, production,
// stage inspection, billing & collection, securities. All additive.
// ---------------------------------------------------------------------------

// Plant planning defaults (single row, id = 1). Shown as "to confirm" in the UI until the
// plant signs them off (confirmed = true).
model PlanSettings {
  id               Int      @id @default(1)
  stdBarMm         Int      @default(6000) @map("std_bar_mm")
  maxCustomMm      Int      @default(6000) @map("max_custom_mm")
  // Trim the plant needs per bar (both ends together), added on top of k x piece length.
  endAllowanceMm   Int      @default(0) @map("end_allowance_mm")
  // Blade loss per cut (0 for shearing/cropping).
  kerfMm           Int      @default(0) @map("kerf_mm")
  // Supply tolerance on ordered length: +0 / +tolPlusMm. Never negative.
  tolPlusMm        Int      @default(20) @map("tol_plus_mm")
  bufferPct        Decimal  @default(0) @map("buffer_pct") @db.Decimal(6, 2)
  minOffcutMm      Int      @default(300) @map("min_offcut_mm")
  // A mark gets its own custom bar length only when it needs at least this many such bars.
  customMinBars    Int      @default(5) @map("custom_min_bars")
  // Rev 2 §10 length rule: a piece length (all marks together) gets a custom bar when it needs at
  // least this many metres and 2+ pieces fit; 6000 mm exact multiples stay custom. 0 = old mark rule.
  customMinMetres  Int      @default(0) @map("custom_min_metres")
  // Red-flag thresholds (days) for the overview.
  bomDueDays       Int      @default(7) @map("bom_due_days")
  galvAlertDays    Int      @default(7) @map("galv_alert_days")
  diAlertDays      Int      @default(7) @map("di_alert_days")
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  workDaysPerWeek  Int      @default(6) @map("work_days_per_week")
  // M15: standard lead time; a PO delivery date earlier than today + this is flagged.
  leadTimeDays     Int      @default(45) @map("lead_time_days")
  confirmed        Boolean  @default(false)
  updatedByName    String?  @map("updated_by_name")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("plan_settings")
}

// Raw-material indent for an order. PRIMARY from the BOM; SUPPLEMENTARY from a re-plan shortfall.
model RmIndent {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  indentNo      String    @unique @map("indent_no")
  // PRIMARY | SUPPLEMENTARY
  kind          String    @default("PRIMARY")
  // MIXED (custom + 6 m) | STANDARD (6 m only)
  strategy      String    @default("MIXED")
  // DRAFT | ISSUED | CANCELLED. Issued indents are locked.
  status        String    @default("DRAFT")
  bomUploadId   Int?      @map("bom_upload_id")
  // Settings used, Mixed vs 6 m comparison, and the bar patterns (pure-function output).
  settings      Json
  comparison    Json?
  plan          Json?
  totalBars     Int       @default(0) @map("total_bars")
  totalWtKg     Decimal   @default(0) @map("total_wt_kg") @db.Decimal(16, 3)
  remarks       String?
  createdById   Int?      @map("created_by_id")
  createdByName String?   @map("created_by_name")
  issuedByName  String?   @map("issued_by_name")
  issuedAt      DateTime? @map("issued_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lines    RmIndentLine[]
  receipts RmReceipt[]

  @@index([orderId])
  @@map("rm_indents")
}

model RmIndentLine {
  id           Int      @id @default(autoincrement())
  indentId     Int      @map("indent_id")
  indent       RmIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  sectionKey   String   @map("section_key")
  sectionLabel String?  @map("section_label")
  barLengthMm  Int      @map("bar_length_mm")
  // CUSTOM (exact multiple for one mark) | STANDARD (6 m nested) | OVERLENGTH (piece longer than a bar)
  lineType     String   @map("line_type")
  forMark      String?  @map("for_mark")
  piecesPerBar Int?     @map("pieces_per_bar")
  bars         Int
  bufferBars   Int      @default(0) @map("buffer_bars")
  kgPerM       Decimal? @map("kg_per_m") @db.Decimal(10, 3)
  wtKg         Decimal? @map("wt_kg") @db.Decimal(16, 3)

  @@index([indentId])
  @@map("rm_indent_lines")
}

// RM received against an order (GRN). Each lot = one section + measured length + nos.
model RmReceipt {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  indentId      Int?      @map("indent_id")
  indent        RmIndent? @relation(fields: [indentId], references: [id], onDelete: SetNull)
  receiptNo     String    @map("receipt_no")
  receiptDate   DateTime  @map("receipt_date") @db.Date
  supplier      String?
  invoiceNo     String?   @map("invoice_no")
  remarks       String?
  createdById   Int?      @map("created_by_id")
  createdByName String?   @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lots RmReceiptLot[]

  @@unique([orderId, receiptNo])
  @@map("rm_receipts")
}

model RmReceiptLot {
  id               Int       @id @default(autoincrement())
  receiptId        Int       @map("receipt_id")
  receipt          RmReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sectionKey       String    @map("section_key")
  sectionLabel     String?   @map("section_label")
  orderedLengthMm  Int       @map("ordered_length_mm")
  measuredLengthMm Int       @map("measured_length_mm")
  nos              Int
  wtKg             Decimal?  @map("wt_kg") @db.Decimal(14, 3)
  heatNo           String?   @map("heat_no")
  // OK | SHORT (below ordered: reject/debit note) | OVER_TOL (above ordered + tolerance)
  lengthStatus     String    @map("length_status")
  // ACCEPTED | REJECTED | DEBIT_NOTE. Only ACCEPTED lots feed the re-plan.
  decision         String    @default("ACCEPTED")
  debitNoteNo      String?   @map("debit_note_no")
  remarks          String?

  @@index([receiptId])
  @@map("rm_receipt_lots")
}

// Cutting plan made from the RM actually received (re-plan). Latest per order is current.
model CuttingPlan {
  id                    Int      @id @default(autoincrement())
  orderId               Int      @map("order_id")
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  settings              Json
  result                Json
  piecesPlanned         Int      @default(0) @map("pieces_planned")
  piecesShort           Int      @default(0) @map("pieces_short")
  offcuts               Int      @default(0)
  supplementaryIndentId Int?     @map("supplementary_indent_id")
  createdByName         String?  @map("created_by_name")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("cutting_plans")
}

// Ceebuild List of Machinery. Rates are editable; `rateConfirmed` stays false until the plant signs off.
model Machine {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  // CROPPING | SHEARING | PUNCHING | NOTCHING | BENDING | WELDING | NUMBERING | THREADING
  operation      String
  // Identical machines of this code working in parallel (e.g. UP-1 x 2).
  units          Int      @default(1)
  ratePerHour    Decimal  @map("rate_per_hour") @db.Decimal(10, 2)
  // cuts | holes | notches | bends | joints | pieces | threads
  rateUnit       String   @map("rate_unit")
  shiftsPerDay   Int      @default(1) @map("shifts_per_day")
  hoursPerShift  Decimal  @default(8) @map("hours_per_shift") @db.Decimal(4, 2)
  utilisationPct Decimal  @default(75) @map("utilisation_pct") @db.Decimal(5, 2)
  rateConfirmed  Boolean  @default(false) @map("rate_confirmed")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  remarks        String?
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  productionEntries ProductionEntry[]

  @@map("machines")
}

// Operations each mark needs (defaults are derived from the section; saved rows override).
model PieceRouting {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  markNo        String   @map("mark_no")
  // CROPPING | SHEARING | NONE
  cutOp         String   @default("SHEARING") @map("cut_op")
  holes         Int      @default(0)
  notches       Int      @default(0)
  bends         Int      @default(0)
  welds         Int      @default(0)
  threads       Int      @default(0)
  numbering     Boolean  @default(true)
  updatedByName String?  @map("updated_by_name")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([orderId, markNo])
  @@map("piece_routings")
}

// Daily production by mark and machine.
model ProductionEntry {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  entryDate     DateTime @map("entry_date") @db.Date
  // A | B | C
  shift         String   @default("A")
  machineId     Int      @map("machine_id")
  machine       Machine  @relation(fields: [machineId], references: [id], onDelete: Restrict)
  operation     String
  markNo        String   @map("mark_no")
  pieces        Int
  operatorName  String?  @map("operator_name")
  remarks       String?
  createdById   Int?     @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([orderId, markNo])
  @@index([entryDate])
  @@map("production_entries")
}

// In-house stage inspection after fabrication, before galvanising.
model StageInspection {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspectionDate DateTime @map("inspection_date") @db.Date
  stage          String
  markNo         String?  @map("mark_no")
  piecesOffered  Int      @map("pieces_offered")
  piecesAccepted Int      @map("pieces_accepted")
  piecesRejected Int      @default(0) @map("pieces_rejected")
  inspector      String?
  remarks        String?
  createdById    Int?     @map("created_by_id")
  createdByName  String?  @map("created_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("stage_inspections")
}

model Invoice {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchId    Int?      @map("dispatch_id")
  dispatch      Dispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  invoiceNo     String    @unique @map("invoice_no")
  invoiceDate   DateTime  @map("invoice_date") @db.Date
  wtKg          Decimal?  @map("wt_kg") @db.Decimal(14, 3)
  taxableAmount Decimal?  @map("taxable_amount") @db.Decimal(16, 2)
  totalAmount   Decimal   @map("total_amount") @db.Decimal(16, 2)
  dueDate       DateTime? @map("due_date") @db.Date
  remarks       String?
  createdById   Int?      @map("created_by_id")
  createdByName String?   @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")

  collections Collection[]

  @@index([orderId])
  @@map("invoices")
}

model Collection {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceId     Int?     @map("invoice_id")
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  receiptDate   DateTime @map("receipt_date") @db.Date
  amount        Decimal  @db.Decimal(16, 2)
  // RTGS | LC | CHEQUE | OTHER
  mode          String   @default("RTGS")
  reference     String?
  // Amount withheld by the client against this receipt (retention).
  retention     Decimal? @db.Decimal(16, 2)
  remarks       String?
  createdById   Int?     @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([invoiceId])
  @@map("collections")
}

// PBG / LC / retention / security deposit held against an order.
model OrderSecurity {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // PBG | ABG | LC | RETENTION | SD
  kind          String
  refNo         String?   @map("ref_no")
  bank          String?
  amount        Decimal   @db.Decimal(16, 2)
  issueDate     DateTime? @map("issue_date") @db.Date
  expiryDate    DateTime? @map("expiry_date") @db.Date
  // ACTIVE | RELEASED | CLAIMED
  status        String    @default("ACTIVE")
  releasedDate  DateTime? @map("released_date") @db.Date
  remarks       String?
  createdById   Int?      @map("created_by_id")
  createdByName String?   @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_securities")
}

// ---------------------------------------------------------------------------
// M14: BOM-based quotation costing. Docket item -> BOM (from the enquiry drawing or an approved
// drawing) -> cost from the Costing Master -> price on the offer -> same BOM into the order.
// ---------------------------------------------------------------------------

// The short, fixed RM purchase list. A BOM structure line must map to one of these (by section
// key) to be costed; any other section is flagged and not costed.
model RmPurchaseItem {
  id         Int      @id @default(autoincrement())
  // Normalised section (sectionKey() of the label), e.g. ISMC75X40. Links to section_master.
  sectionKey String   @unique @map("section_key")
  label      String
  // CHANNEL | ANGLE | FLAT | ROD | OTHER
  category   String
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("rm_purchase_items")
}

// Costing Master: every factor used by the cost calculation. Rows are never edited: a change is a
// new row with its own effective date, so an old quotation can always show the rates of its date.
model CostRate {
  id            Int      @id @default(autoincrement())
  // RM_RATE | WASTAGE_PCT | FAB_RATE | GALV_RATE | ZINC_PCT | GALV_TRANSPORT | FREIGHT_MT |
  // INTEREST_PCT | CREDIT_DAYS | LC_BG_PCT | INSPECTION | PACKING | MIN_VA_PCT | NB_RATE | BOUGHT_OUT
  kind          String
  // What the rate is for: purchase item section key, fabrication type, state, N&B size,
  // bought-out item name, or DEFAULT. Stored upper-case.
  subject       String   @default("DEFAULT")
  value         Decimal  @db.Decimal(14, 4)
  // Rs/kg, %, Rs/MT, days, Rs/set, Rs/no ...
  unit          String
  effectiveFrom DateTime @map("effective_from") @db.Date
  source        String?
  // Rev 2 §4.1: ESTIMATE | QUOTE | PO | GRN | ACTUAL (null = not stated; legacy "INTERIM" source = ESTIMATE)
  rateType      String?   @map("rate_type")
  supplier      String?
  // Optional end of validity; the next version's effective date ends it anyway.
  validTo       DateTime? @map("valid_to") @db.Date
  // Update frequency set by Puja (days, e.g. 7 weekly, 30 monthly); overdue = effective_from + freq < today.
  updateFreqDays Int?     @map("update_freq_days")
  // Who keeps the rate up to date (e.g. Purchase – Baptu).
  owner         String?
  createdById   Int?     @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([kind, subject, effectiveFrom])
  @@map("cost_rates")
}

// Approved Drawing Library: client-approved drawings with their BOM, reused on later enquiries.
model ApprovedDrawing {
  id               Int       @id @default(autoincrement())
  utility          String
  state            String?
  // Item / structure type, matched to the docket item structure type (case-insensitive).
  itemType         String    @map("item_type")
  drawingNo        String    @map("drawing_no")
  revision         String    @default("0")
  approvalLetterNo String?   @map("approval_letter_no")
  approvalDate     DateTime? @map("approval_date") @db.Date
  // PENDING (added by a technical user, waiting for Admin) | APPROVED | SUPERSEDED
  status           String    @default("APPROVED")
  approvedByName   String?   @map("approved_by_name")
  approvedAt       DateTime? @map("approved_at")
  fileLink         String?   @map("file_link")
  remarks          String?
  // Docket item BOM this drawing was created from, if any.
  fromItemBomId    Int?      @map("from_item_bom_id")
  createdById      Int?      @map("created_by_id")
  createdByName    String?   @map("created_by_name")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lines    ApprovedDrawingLine[]
  itemBoms ItemBom[]

  @@unique([drawingNo, revision])
  @@index([itemType])
  @@map("approved_drawings")
}

model ApprovedDrawingLine {
  id          Int             @id @default(autoincrement())
  drawingId   Int             @map("drawing_id")
  drawing     ApprovedDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  rowNo       Int             @map("row_no")
  markNo      String?         @map("mark_no")
  description String?
  section     String?
  sectionKey  String?         @map("section_key")
  lengthMm    Int?            @map("length_mm")
  qtyPerSet   Decimal?        @map("qty_per_set") @db.Decimal(14, 3)
  kgPerM      Decimal?        @map("kg_per_m") @db.Decimal(10, 3)
  // Weight of one piece (kg), e.g. for nuts and bolts lines without a length.
  unitWtKg    Decimal?        @map("unit_wt_kg") @db.Decimal(14, 3)
  // STRUCTURE | NUTS_BOLTS | BOUGHT_OUT
  category    String          @default("STRUCTURE")
  // N&B size or bought-out item name (Costing Master subject of its rate).
  rateKey     String?         @map("rate_key")
  // Supplied but not billed (as marked on the client BOM).
  nonBillable Boolean         @default(false) @map("non_billable")

  @@index([drawingId])
  @@map("approved_drawing_lines")
}

// The BOM of one docket item (iteam-table row). The latest per item is the current one.
model ItemBom {
  id              Int              @id @default(autoincrement())
  itemId          Int              @map("item_id")
  docketId        Int?             @map("docket_id")
  // ENQUIRY_DRAWING | APPROVED_DRAWING | MANUAL
  source          String
  drawingId       Int?             @map("drawing_id")
  drawing         ApprovedDrawing? @relation(fields: [drawingId], references: [id], onDelete: SetNull)
  // Drawing no + revision as shown on the BOM (kept even if the library row changes).
  drawingRef      String?          @map("drawing_ref")
  // UTILITY_ITEM | STATE_ITEM | ANY_ITEM (reference only - confirm); null for enquiry drawings
  matchLevel      String?          @map("match_level")
  fileName        String?          @map("file_name")
  s3Key           String?          @map("s3_key")
  structureType   String?          @map("structure_type")
  // PLAIN_CUT | CLAMP_BENT | WELDED (fabrication / conversion rate)
  fabType         String           @default("PLAIN_CUT") @map("fab_type")
  galvanised      Boolean          @default(true)
  // Painted finish (e.g. DTR fencing, two coats): PAINT_RATE Rs/kg black is added. Not with galvanised.
  painted         Boolean          @default(false)
  // BLACK | GALV: the weight the client is billed on
  billingBasis    String           @default("GALV") @map("billing_basis")
  // WEIGHT (freight Rs/MT) | SPACE (bulky: trips = ROUNDUP(sets / sets per truck) x trip rate)
  loadBasis       String           @default("WEIGHT") @map("load_basis")
  setsPerTruck    Decimal?         @map("sets_per_truck") @db.Decimal(10, 2)
  // DRAFT | CONFIRMED
  status          String           @default("DRAFT")
  extractNote     String?          @map("extract_note")
  createdById     Int?             @map("created_by_id")
  createdByName   String?          @map("created_by_name")
  confirmedByName String?          @map("confirmed_by_name")
  confirmedAt     DateTime?        @map("confirmed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  lines    ItemBomLine[]
  groups   ItemBomGroup[]
  costings ItemCosting[]

  @@index([itemId])
  @@index([docketId])
  @@map("item_boms")
}

// One structure type inside an item BOM, with its own set count. A mixed BOM (e.g. SBPDCL RDSS:
// ~30 structures over 5 sites under one docket item) has many; a single-structure BOM has one.
model ItemBomGroup {
  id        Int      @id @default(autoincrement())
  bomId     Int      @map("bom_id")
  bom       ItemBom  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  seq       Int
  name      String
  drawingNo String?  @map("drawing_no")
  drawingId Int?     @map("drawing_id")
  // Sets of this structure. Null on a single-structure BOM = derived from the item quantity (kg).
  sets      Decimal? @db.Decimal(14, 3)
  // Set count per site, e.g. {"Banka Khaira": 1, "Jamui Indpey": 1}.
  siteSets  Json?    @map("site_sets")

  lines ItemBomLine[]

  @@index([bomId])
  @@map("item_bom_groups")
}

model ItemBomLine {
  id          Int           @id @default(autoincrement())
  bomId       Int           @map("bom_id")
  bom         ItemBom       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  groupId     Int?          @map("group_id")
  group       ItemBomGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rowNo       Int           @map("row_no")
  markNo      String?       @map("mark_no")
  description String?
  section     String?
  sectionKey  String?       @map("section_key")
  lengthMm    Int?          @map("length_mm")
  qtyPerSet   Decimal?      @map("qty_per_set") @db.Decimal(14, 3)
  // kg/m as read from the drawing; the costing always uses the GTP section master.
  kgPerM      Decimal?      @map("kg_per_m") @db.Decimal(10, 3)
  unitWtKg    Decimal?      @map("unit_wt_kg") @db.Decimal(14, 3)
  // STRUCTURE | NUTS_BOLTS | BOUGHT_OUT
  category    String        @default("STRUCTURE")
  // IN_SCOPE | NOT_IN_SCOPE | BOUGHT_OUT | CLIENT_SUPPLY
  scope       String        @default("IN_SCOPE")
  nonBillable Boolean       @default(false) @map("non_billable")
  // N&B size (M16X40) or bought-out item name: the Costing Master subject of its rate.
  rateKey     String?       @map("rate_key")
  // Fabrication category (FAB_RATE subject) set by hand; null = picked from section/description.
  fabCat      String?       @map("fab_cat")

  @@index([bomId])
  @@map("item_bom_lines")
}

// One saved costing of an item BOM: the rates used (snapshot) and the result. Saved costings are
// never changed; Apply writes the selling price to the quotation item.
model ItemCosting {
  id            Int       @id @default(autoincrement())
  bomId         Int       @map("bom_id")
  bom           ItemBom   @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemId        Int       @map("item_id")
  docketId      Int?      @map("docket_id")
  quoteDate     DateTime  @map("quote_date") @db.Date
  vaPct         Decimal   @map("va_pct") @db.Decimal(8, 3)
  billingBasis  String    @map("billing_basis")
  sets          Decimal   @db.Decimal(14, 3)
  blackWtKg     Decimal   @map("black_wt_kg") @db.Decimal(16, 3)
  galvWtKg      Decimal   @map("galv_wt_kg") @db.Decimal(16, 3)
  costTotal     Decimal   @map("cost_total") @db.Decimal(16, 2)
  sellTotal     Decimal   @map("sell_total") @db.Decimal(16, 2)
  // Structure selling price per kg on the billing basis.
  sellPerKg     Decimal   @map("sell_per_kg") @db.Decimal(12, 2)
  sellPerSet    Decimal   @map("sell_per_set") @db.Decimal(14, 2)
  // Nuts and bolts and bought-out lines, quoted as separate offer lines.
  nbSellTotal   Decimal   @default(0) @map("nb_sell_total") @db.Decimal(16, 2)
  boSellTotal   Decimal   @default(0) @map("bo_sell_total") @db.Decimal(16, 2)
  // Full calculation: rates used (ids + effective dates), per-line breakdown.
  detail        Json
  // Check results: below minimum VA, variance vs last quote, blank weight/rate lines.
  flags         Json
  applied       Boolean   @default(false)
  appliedAt     DateTime? @map("applied_at")
  createdById   Int?      @map("created_by_id")
  createdByName String?   @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([itemId])
  @@index([docketId])
  @@map("item_costings")
}

// Rev 2 §11: frozen quotation as sent / approved. Never changed after it is written; a new revision
// is a new row. Holds the docket, every item and price, the costings and the rates in force.
model QuotationSnapshot {
  id            Int      @id @default(autoincrement())
  docketId      Int      @map("docket_id")
  docketNo      String?  @map("docket_no")
  rev           Int
  quotedOn      DateTime @map("quoted_on") @db.Date
  // SENT | APPROVED
  status        String   @default("SENT")
  note          String?
  sentTo        String?  @map("sent_to")
  totalValue    Decimal? @map("total_value") @db.Decimal(16, 2)
  payload       Json
  createdById   Int?     @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([docketId, rev])
  @@map("quotation_snapshots")
}

// Rev 2 §8 seed from the Power BI exports (later the daily Power Automate / n8n feed). Incremental:
// rows are keyed by a hash of their content and never deleted.
model ErpPoLine {
  id        Int       @id @default(autoincrement())
  rowHash   String    @unique @map("row_hash")
  indentNo  String?   @map("indent_no")
  poNo      String?   @map("po_no")
  party     String?
  orderDate DateTime? @map("order_date") @db.Date
  itemName  String?   @map("item_name")
  uom       String?
  rate      Decimal?  @db.Decimal(14, 4)
  poQty     Decimal?  @map("po_qty") @db.Decimal(16, 3)
  grnQty    Decimal?  @map("grn_qty") @db.Decimal(16, 3)
  balToGrn  Decimal?  @map("bal_to_grn") @db.Decimal(16, 3)
  source    String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([itemName])
  @@map("erp_po_lines")
}

model ErpIndentLine {
  id             Int       @id @default(autoincrement())
  rowHash        String    @unique @map("row_hash")
  indentNo       String?   @map("indent_no")
  indentDate     DateTime? @map("indent_date") @db.Date
  itemName       String?   @map("item_name")
  uom            String?
  indentQty      Decimal?  @map("indent_qty") @db.Decimal(16, 3)
  requisitionBy  String?   @map("requisition_by")
  indentBy       String?   @map("indent_by")
  purpose        String?
  requireDate    DateTime? @map("require_date") @db.Date
  deliverySch    String?   @map("delivery_sch")
  poQty          Decimal?  @map("po_qty") @db.Decimal(16, 3)
  balToPo        Decimal?  @map("bal_to_po") @db.Decimal(16, 3)
  source         String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("erp_indent_lines")
}

// FREIGHT HISTORY RECORD (FO table), the base of the Freight Master lanes (§5).
model FreightHistory {
  id           Int       @id @default(autoincrement())
  rowHash      String    @unique @map("row_hash")
  foNo         String?   @map("fo_no")
  foDate       DateTime? @map("fo_date") @db.Date
  docNo        String?   @map("doc_no")
  docDate      DateTime? @map("doc_date") @db.Date
  fromLoc      String?   @map("from_loc")
  fromPin      String?   @map("from_pin")
  toLoc        String?   @map("to_loc")
  toPin        String?   @map("to_pin")
  vehicleType  String?   @map("vehicle_type")
  truckNo      String?   @map("truck_no")
  netWeight    Decimal?  @map("net_weight") @db.Decimal(14, 3)
  foRate       Decimal?  @map("fo_rate") @db.Decimal(14, 2)
  freightValue Decimal?  @map("freight_value") @db.Decimal(14, 2)
  distance     Decimal?  @db.Decimal(10, 1)
  billNo       String?   @map("bill_no")
  billAmount   Decimal?  @map("bill_amount") @db.Decimal(14, 2)
  source       String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([toPin])
  @@map("freight_history")
}

// Rev 2 §2 (enquiry automation, stage 1): every mail to info@ read by n8n + Gemini. An ENQUIRY creates
// a docket (or links to the existing one); anything else is recorded so it is not read again.
model EnquiryIntake {
  id             Int       @id @default(autoincrement())
  // "thread:<gmail thread id>" of the mail archive
  threadRef      String    @map("thread_ref")
  // ENQUIRY | PO | AMENDMENT | CLARIFICATION | OTHER
  classification String
  // CREATED (new docket) | LINKED (existing docket) | NOT_ENQUIRY | FAILED
  status         String
  subject        String?
  sender         String?
  mailDate       DateTime? @map("mail_date")
  partyName      String?   @map("party_name")
  enquiryNo      String?   @map("enquiry_no")
  dueDate        DateTime? @map("due_date") @db.Date
  docketId       Int?      @map("docket_id")
  docketNo       String?   @map("docket_no")
  // Files of the mail (name, kind, Drive link) and what the AI read (party, items, terms, notes).
  files          Json?
  extracted      Json?
  // Stage 2 draft prices (approved drawing / last quoted / none), never applied without approval.
  autoCost       Json?     @map("auto_cost")
  model          String?
  error          String?
  // REGRET needs a reason approved by Puja (E5); PO / LOST close the enquiry.
  outcome        String?
  outcomeNote    String?   @map("outcome_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([threadRef])
  @@index([docketId])
  @@map("enquiry_intakes")
}

// Rev 2 §10 store stock (usable offcuts, spare full bars) used before ordering new bars.
// Deducted only when an indent is ISSUED (reservedIndentNo = that indent).
model RmStoreStock {
  id               Int      @id @default(autoincrement())
  section          String
  sectionKey       String   @map("section_key")
  lengthMm         Int      @map("length_mm")
  qty              Int
  // OFFCUT | FULL
  kind             String   @default("OFFCUT")
  // Set when the store keeps these bars for one piece length (that requirement drops first).
  forPieceLengthMm Int?     @map("for_piece_length_mm")
  location         String?
  note             String?
  active           Boolean  @default(true)
  reservedIndentNo String?  @map("reserved_indent_no")
  createdByName    String?  @map("created_by_name")
  updatedByName    String?  @map("updated_by_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([sectionKey])
  @@map("rm_store_stock")
}
