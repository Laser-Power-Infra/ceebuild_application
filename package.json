{
  "name": "ceebuild-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-port.js 3001",
    "dev": "next dev -p 3001",
    "build": "next build",
    "prestart": "node scripts/free-port.js 3001",
    "start": "next start -p 3001",
    "seed": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/seed.ts",
    "users": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/users.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "gmail-auth": "tsx scripts/gmail-auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@reduxjs/toolkit": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.475.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "pg": "^8.13.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
