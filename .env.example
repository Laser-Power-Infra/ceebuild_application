# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ceebuild-items"

# App port (used in dev; Docker overrides this)
PORT=6011

# --- Authentication (required) ---------------------------------------------
# Secret used to sign the login session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out. If it is missing the app refuses all requests (fails closed).
AUTH_SECRET=""

# Set to "true" only when the dashboard is served over HTTPS (marks the cookie Secure).
# Leave unset/false while it is reached over plain http://192.168.1.190:6011
COOKIE_SECURE=false

# Login users are stored in the "users" table. Manage them with:
#   npm run users -- add <username> --name "Full Name" --role Admin|User|Viewer
#   npm run users -- sync config/users.json      (list format: config/users.example.json)
#   npm run users -- list | set-password | set-role | disable | enable
# Roles: Admin = everything incl. deletes & master dropdowns; User = view/create/edit;
#        Viewer = read-only.
